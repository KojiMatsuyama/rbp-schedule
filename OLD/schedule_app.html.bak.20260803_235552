    phiDays:1, mixingRestriction:"銅剤と混合不可（薬害・分解）", mixingBanTargets:["銅剤"],
    maxApplications:2, toxicityClass:"普通物", system:"METI（複合体Ⅱ阻害／IRAC 21A）", systemCode:"IRAC21A" },
