  let csv = 'Date,Diseases,Pests,Vector,EB_Predicted,EB_Name\n';
  keys.forEach(dateKey => {
    const rec = records[dateKey];
    const pred = classifyVector(rec.vector);
    const diseases = rec.pests.filter(p => DISEASES.find(d => d.name === p && d.type === 'disease')).join(';');
