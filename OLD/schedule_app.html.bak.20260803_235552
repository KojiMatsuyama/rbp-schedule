// 自動処方箋RBP: 「今回の処方」承認カードのHTML生成
// （旧・候補選択UIの renderSpecBox は下に残置。呼び出し元は本関数に切り替え済み）
function renderPrescriptionCard(vector) {
  const safetyVector = buildSafetyVector(records, selectedDate);
  const result = buildPrescriptionSet(vector, safetyVector);

  if (!result.best) {
    return `
      <div class="spec-result">
        <h3>💊 今回の処方（Spec-RBP）</h3>
        <p style="color:var(--muted);font-size:.8rem;">候補薬剤がありません</p>
      </div>`;
  }

  function renderSetLabel(set) {
    return set.pesticides.map(p => p.name).join(' + ');
  }

  function renderDrugLine(p) {
    const usageCount = safetyVector.usageState[p.id] || 0;
    return `
      <div class="prescription-drug-line">
        <strong>${p.name}</strong> <span class="spec-system">${p.system}</span><br>
        対象: ${p.targetNames.join('、')} / PHI:${p.phiDays}日 /
        散布回数 ${usageCount}/${p.maxApplications === Infinity ? '無制限' : p.maxApplications}回 / ${p.toxicityClass}
      </div>`;
  }

  function renderWarningBadges(set) {
    return set.warnings.map(w => {
      const cls = w.includes('劇物') ? 'danger' : (w.includes('抵抗性管理上有効') ? 'good' : 'warn');
      return `<span class="spec-badge ${cls}">${w}</span>`;
    }).join('');
  }

  const best = result.best;
  const titleLabel = renderSetLabel(best);
  const drugLines = best.pesticides.map(renderDrugLine).join('');
  const badges = renderWarningBadges(best);
  const approveIds = best.pesticides.map(p => `'${p.id}'`).join(',');

  const breakdownHTML = `
    <table class="prescription-breakdown">
      <tr><td class="axis-label">効果</td><td>${best.matchCount}/${best.breakdown.effectiveness.targetSum}項目 一致（${(best.coverageRatio*100).toFixed(0)}%） = ${best.effectivenessScore.toFixed(1)}</td></tr>
      <tr><td class="axis-label">安全性</td><td>${best.safetyScore.toFixed(1)}</td></tr>
      <tr><td class="axis-label">抵抗性リスク</td><td>${best.resistanceScore.toFixed(1)}${best.breakdown.resistance.note ? '（' + best.breakdown.resistance.note + '）' : ''}</td></tr>
      <tr><td class="axis-label">混合可否</td><td>適合（混用禁止組み合わせなし）</td></tr>
      <tr class="total"><td class="axis-label">総合スコア</td><td>${best.totalScore.toFixed(1)}</td></tr>
    </table>`;

  const primaryCardHTML = `
    <div class="prescription-card">
      <div class="prescription-title">今回の処方: ${titleLabel}</div>
      ${drugLines}
      ${badges ? `<div class="spec-warnings">${badges}</div>` : ''}
      ${breakdownHTML}
      <button class="btn btn-primary btn-sm prescription-approve-btn" onclick="approvePrescription([${approveIds}])">✅ 承認して記録</button>
    </div>`;

  const alternativesHTML = result.alternatives.length
    ? `<details class="spec-alternatives"><summary>他の処方案候補（${result.alternatives.length}件）</summary>
        <ul class="spec-candidate-list">${result.alternatives.slice(0, 10).map(set => `
          <li class="spec-altset-item">
            <div class="spec-name">${renderSetLabel(set)}</div>
            <div class="spec-meta">総合スコア ${set.totalScore.toFixed(1)}（効果${set.effectivenessScore.toFixed(1)} / 安全性${set.safetyScore.toFixed(1)} / 抵抗性${set.resistanceScore.toFixed(1)}）</div>
          </li>`).join('')}</ul>
      </details>`
    : '';

  const excludedAll = [...result.excludedIndividual, ...result.excludedSets];
  const excludedHTML = excludedAll.length
    ? `<details class="spec-excluded"><summary>除外された薬剤/組み合わせ（${excludedAll.length}件）</summary>
        <ul class="spec-candidate-list">${excludedAll.map(e => `
          <li class="spec-excluded-item">
            <div class="spec-name">${e.pesticides.map(p => p.name).join(' + ')}</div>
            <div class="spec-reason">${e.exclusionReasons.join('／')}</div>
          </li>`).join('')}</ul>
      </details>`
    : '';

  return `
    <div class="spec-result">
      <h3>💊 今回の処方（Spec-RBP）</h3>
      ${primaryCardHTML}
      ${alternativesHTML}
      ${excludedHTML}
    </div>`;
}

// Spec-RBP処方候補セクションのHTML生成（旧・候補選択UI。呼び出し元なし、参考として残置）
function renderSpecBox(vector) {
  const safetyVector = buildSafetyVector(records, selectedDate);
  const specBox = buildSpecBox(vector, safetyVector);

  function renderCandidateCard(c, rank) {
    const badges = c.warnings.map(w => {
      const cls = w.startsWith('劇物') ? 'danger' : 'warn';
      return `<span class="spec-badge ${cls}">${w}</span>`;
    }).join('');

    return `
      <li class="spec-candidate ${rank === 1 ? 'rank-1' : ''}">
        <div class="spec-name">${c.pesticide.name} <span class="spec-system">${c.pesticide.system}</span></div>
        <div class="spec-reason">対象: ${c.pesticide.targetNames.join('、')}（一致度 ${c.matchCount}）</div>
        <div class="spec-meta">PHI:${c.pesticide.phiDays}日 / 散布回数 ${safetyVector.usageState[c.pesticide.id] || 0}/${c.pesticide.maxApplications === Infinity ? '無制限' : c.pesticide.maxApplications}回 / ${c.pesticide.toxicityClass}</div>
        ${badges ? `<div class="spec-warnings">${badges}</div>` : ''}
        <button class="btn btn-primary btn-sm" onclick="addPesticideToRecord('${c.pesticide.id}')">この薬剤で登録</button>
      </li>`;
  }

  function renderExcludedItem(c) {
    return `
      <li class="spec-excluded-item">
        <div class="spec-name">${c.pesticide.name}</div>
        <div class="spec-reason">${c.exclusionReasons.join('／')}</div>
      </li>`;
  }

  const candidatesHTML = specBox.candidates.length
    ? specBox.candidates.map((c, i) => renderCandidateCard(c, i + 1)).join('')
    : '<li style="color:var(--muted);font-size:.8rem;">候補薬剤がありません</li>';

  const alternativesHTML = specBox.alternatives.length
    ? `<details class="spec-alternatives"><summary>代替候補をもっと見る（${specBox.alternatives.length}件）</summary>
        <ul class="spec-candidate-list">${specBox.alternatives.map((c, i) => renderCandidateCard(c, i + 6)).join('')}</ul>
      </details>`
    : '';

  const excludedHTML = specBox.excluded.length
    ? `<details class="spec-excluded"><summary>除外された薬剤（${specBox.excluded.length}件）</summary>
        <ul class="spec-candidate-list">${specBox.excluded.map(renderExcludedItem).join('')}</ul>
      </details>`
    : '';

  return `
    <div class="spec-result">
      <h3>💊 処方候補（Spec-RBP）</h3>
      <ul class="spec-candidate-list">${candidatesHTML}</ul>
      ${alternativesHTML}
      ${excludedHTML}
    </div>`;
}

// 薬剤選択→履歴記録（病害虫選択の保存とは別動線。旧UIの名残、参考として残置）
function addPesticideToRecord(pesticideId) {
  if (!selectedDate) return;
  if (!records[selectedDate]) {
    alert('先に病害虫選択を登録してください');
    return;
  }
  const rec = records[selectedDate];
  rec.pesticideIds = rec.pesticideIds || [];
  if (!rec.pesticideIds.includes(pesticideId)) {
    rec.pesticideIds.push(pesticideId);
  }
  saveRecords();
  renderDetail();
}

// 自動決定された処方セット（1剤 or 2剤）を一括承認し、防除暦・使用回数に反映する
function approvePrescription(pesticideIds) {
  if (!selectedDate || !records[selectedDate]) {
    alert('先に病害虫選択を登録してください');
    return;
  }
  const rec = records[selectedDate];
  rec.pesticideIds = rec.pesticideIds || [];
  pesticideIds.forEach(id => {
    if (!rec.pesticideIds.includes(id)) rec.pesticideIds.push(id);
  });
  saveRecords();
  renderCalendar();
  renderDetail();
}

function saveRecord() {
  if (!selectedDate) return;

  const checkboxes = document.querySelectorAll('#tab-detail .pest-check input[type="checkbox"]:checked');
  const pests = [];
  const vector = new Array(10).fill(0);

  checkboxes.forEach(cb => {
    const idx = parseInt(cb.dataset.idx);
    pests.push(DISEASES[idx].name);
    vector[idx] = 1;
  });

  const existingPesticideIds = (records[selectedDate] && records[selectedDate].pesticideIds) || [];
  records[selectedDate] = { pests, vector, pesticideIds: existingPesticideIds };
  saveRecords();
  renderCalendar();
  renderDetail();
}

function deleteRecord() {
  if (!selectedDate) return;
  if (!confirm('この日の実績を削除しますか？')) return;
  delete records[selectedDate];
  saveRecords();
  renderCalendar();
  renderDetail();
  renderSchedule();
}

