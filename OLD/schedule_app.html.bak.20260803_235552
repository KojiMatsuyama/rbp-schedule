// ═══════════════════════════════════════════
// Scoring functions
// ═══════════════════════════════════════════
function dotProduct(a, b) {
  return a.reduce((sum, x, i) => sum + x * b[i], 0);
}

function norm(v) {
  return Math.sqrt(v.reduce((s, x) => s + x * x, 0));
}

function cosineSimilarity(a, b) {
  const d = dotProduct(a, b);
  const na = norm(a);
  const nb = norm(b);
  if (na === 0 || nb === 0) return 0;
  return d / (na * nb);
}

function classifyVector(v) {
  // ── Method B: 行列演算（Broadcast-Hadamard-Reduce） ──
  // 従来: for each EB: cosineSimilarity(v, vec)  →  新: EB_MATRIX × v̂^T
  const { scores: cosScores } = cosineSimMatrix(EB_MATRIX, v);

  // dotProduct も併算出（全スコアに含めるため）
  const dotScores = EB_MATRIX.map(row => dotProduct(v, row));

  let bestEB = null;
  let bestCosine = -Infinity;
  let bestDot = -Infinity;
  const allScores = {};

  const labels = Object.keys(EB_VECTORS);
  for (let i = 0; i < labels.length; i++) {
    const label = labels[i];
    allScores[label] = { cosine: cosScores[i], dot: dotScores[i] };
    if (cosScores[i] > bestCosine) {
      bestCosine = cosScores[i];
      bestEB = label;
      bestDot = dotScores[i];
    }
  }

  return { eb: bestEB, name: EB_NAMES[bestEB] || '', cosine: bestCosine, dot: bestDot, allScores };
}

// ═══════════════════════════════════════════
// Spec-RBP — SafetyVector（安全制約ベクトル）算出
// ═══════════════════════════════════════════

// 対象年内のrecordsから、薬剤ごとの散布回数を集計する
function computeUsageState(records, year) {
  const usage = {};
  for (const dateKey of Object.keys(records)) {
    if (!dateKey.startsWith(String(year))) continue;
    const ids = records[dateKey].pesticideIds || [];
    ids.forEach(id => { usage[id] = (usage[id] || 0) + 1; });
  }
  return usage;
}

// targetDateより前の直近の散布記録（薬剤ID・系統込み）を取得する
function findLastSpray(records, targetDateStr) {
  const targetTime = new Date(targetDateStr + 'T00:00:00').getTime();
  const keys = Object.keys(records)
    .filter(k => (records[k].pesticideIds || []).length > 0)
    .filter(k => new Date(k + 'T00:00:00').getTime() < targetTime)
    .sort((a, b) => new Date(b + 'T00:00:00') - new Date(a + 'T00:00:00'));

  if (keys.length === 0) return null;

  const lastDate = keys[0];
  const pesticideIds = records[lastDate].pesticideIds || [];
  const systems = pesticideIds
    .map(id => (PESTICIDE_DB.find(p => p.id === id) || {}).system)
    .filter(Boolean);

  return { date: lastDate, pesticideIds, systems };
}

function computeIntervalDays(lastSprayDate, targetDateStr) {
  if (!lastSprayDate) return null;
  const t1 = new Date(lastSprayDate + 'T00:00:00').getTime();
  const t2 = new Date(targetDateStr + 'T00:00:00').getTime();
  return Math.round((t2 - t1) / 86400000);
}

// 直近lookbackCount件の散布日を新しい順に走査し、系統コードごとの連続登場回数を数える
function computeRotationState(records, targetDateStr, lookbackCount = 5) {
  const targetTime = new Date(targetDateStr + 'T00:00:00').getTime();
  const keys = Object.keys(records)
    .filter(k => (records[k].pesticideIds || []).length > 0)
    .filter(k => new Date(k + 'T00:00:00').getTime() < targetTime)
    .sort((a, b) => new Date(b + 'T00:00:00') - new Date(a + 'T00:00:00'))
    .slice(0, lookbackCount);

  const rotationState = {};
  const activeSystems = new Set();
  let firstIteration = true;

  for (const dateKey of keys) {
    const ids = records[dateKey].pesticideIds || [];
    const systemsUsed = new Set(
      ids.map(id => (PESTICIDE_DB.find(p => p.id === id) || {}).systemCode).filter(Boolean)
    );

    if (firstIteration) {
      systemsUsed.forEach(s => { rotationState[s] = 1; activeSystems.add(s); });
      firstIteration = false;
      continue;
    }

    activeSystems.forEach(s => {
      if (systemsUsed.has(s)) {
        rotationState[s] = (rotationState[s] || 0) + 1;
      } else {
        activeSystems.delete(s);
      }
    });
  }

  return rotationState;
}

function buildSafetyVector(records, targetDateStr) {
  const year = targetDateStr.slice(0, 4);
  const usageState = computeUsageState(records, year);
  const last = findLastSpray(records, targetDateStr);
  const lastSprayDate = last ? last.date : null;
  const intervalDays = computeIntervalDays(lastSprayDate, targetDateStr);
  const rotationState = computeRotationState(records, targetDateStr);

  return {
    targetDate: targetDateStr,
    usageState,
    lastSprayDate,
    lastPesticideIds: last ? last.pesticideIds : [],
    lastSystems: last ? last.systems : [],
    intervalDays,
    rotationState,
  };
}

// ═══════════════════════════════════════════
// Spec-RBP — マッチング・除外・スコアリング
// ═══════════════════════════════════════════

// Mirror ID: EBベクトルで1になっている次元と対象が重なる薬剤を抽出
function matchCandidates(ebVector) {
  return PESTICIDE_DB
    .map(p => ({ pesticide: p, matchCount: dotProduct(p.targetVector, ebVector) }))
    .filter(x => x.matchCount > 0);
}

// 相互の混用禁止関係を判定する（薬剤どうしのsystem/mixingBanTargetsの文字列突合）
function hasMixingConflict(pesticide, otherId) {
  const other = PESTICIDE_DB.find(p => p.id === otherId);
  if (!other) return false;

  const aTargets = pesticide.mixingBanTargets || [];
  const bTargets = other.mixingBanTargets || [];

  const aBansB = aTargets.some(t => other.system.includes(t) || other.name.includes(t));
  const bBansA = bTargets.some(t => pesticide.system.includes(t) || pesticide.name.includes(t));

  return aBansB || bBansA;
}

function scoreCandidate(matched, ebVector, safetyVector) {
  const p = matched.pesticide;
  const matchCount = matched.matchCount;
  const targetSum = ebVector.reduce((s, v) => s + v, 0);
  const coverageRatio = targetSum > 0 ? matchCount / targetSum : 0;

  const usageCount = safetyVector.usageState[p.id] || 0;
  const exclusionReasons = [];
  const warnings = [];

  // ハード除外: 散布回数上限超過
  if (usageCount >= p.maxApplications) {
    exclusionReasons.push(`散布回数上限に到達（${usageCount}/${p.maxApplications === Infinity ? '無制限' : p.maxApplications}回）`);
  }

  // ハード除外: 前回散布薬剤との混用禁止
  const mixingConflicts = safetyVector.lastPesticideIds.filter(id => hasMixingConflict(p, id));
  if (mixingConflicts.length > 0) {
    const names = mixingConflicts.map(id => (PESTICIDE_DB.find(x => x.id === id) || {}).name).join('、');
    exclusionReasons.push(`前回散布薬剤（${names}）と混用禁止`);
  }

  const excluded = exclusionReasons.length > 0;

  let score = matchCount * 10 + coverageRatio * 5;

  if (!excluded) {
    if (safetyVector.intervalDays !== null && safetyVector.intervalDays < p.phiDays) {
      warnings.push(`PHI残日数要確認（前回散布から${safetyVector.intervalDays}日、PHI${p.phiDays}日）`);
      score -= 10;
    }
    const rotationCount = safetyVector.rotationState[p.systemCode] || 0;
    if (rotationCount >= 2 && p.systemCode !== 'MIX' && p.systemCode !== 'PHYSICAL') {
      warnings.push(`同系統（${p.system}）を${rotationCount}回連続使用中（抵抗性リスク）`);
      score -= 15;
    }
    if (p.toxicityClass === '劇物') {
      warnings.push('劇物区分');
    }
  }

  return { pesticide: p, matchCount, coverageRatio, excluded, exclusionReasons, warnings, score };
}

function rankPrescriptions(ebVector, safetyVector) {
  const matched = matchCandidates(ebVector);
  const scored = matched.map(m => scoreCandidate(m, ebVector, safetyVector));

  const ranked = scored.filter(s => !s.excluded).sort((a, b) => b.score - a.score);
  const excluded = scored.filter(s => s.excluded);

  return { ranked, excluded };
}

function buildSpecBox(ebVector, safetyVector) {
  const { ranked, excluded } = rankPrescriptions(ebVector, safetyVector);
  return {
    candidates: ranked.slice(0, 5),
    alternatives: ranked.slice(5),
    excluded,
  };
}

// ═══════════════════════════════════════════
// 自動処方箋RBP（Spec-RBP） — 1剤/2剤セットの自動決定
// 「候補を選ばせる」のではなく「処方セットを1つ決定する」
// ═══════════════════════════════════════════
const NON_ROTATION_SYSTEM_CODES = ['MIX', 'PHYSICAL'];

// セット内の薬剤同士（1剤なら常にfalse、2剤ならhasMixingConflictを再利用）に
// 混用禁止関係がないかを判定する
function setHasInternalMixingConflict(pesticideList) {
  if (pesticideList.length < 2) return false;
  const [a, b] = pesticideList;
  return hasMixingConflict(a, b.id);
}

// 除外理由の人間可読メッセージを生成する（hasMixingConflictの判定ロジックを再利用）
function buildMixingReason(a, b) {
  const reasons = [];
  const aTargets = a.mixingBanTargets || [];
  const bTargets = b.mixingBanTargets || [];

  const aBanTarget = aTargets.find(t => b.system.includes(t) || b.name.includes(t));
  if (aBanTarget) reasons.push(`${a.name}は${b.name}（${aBanTarget}）と混用不可`);

  const bBanTarget = bTargets.find(t => a.system.includes(t) || a.name.includes(t));
  if (bBanTarget) reasons.push(`${b.name}は${a.name}（${bBanTarget}）と混用不可`);

  return reasons;
}

// 前回散布薬剤との混用禁止をセット全体に対して判定する
function findLastSprayConflictReasons(pesticideList, safetyVector) {
  const reasons = [];
  for (const p of pesticideList) {
    for (const lastId of safetyVector.lastPesticideIds) {
      if (hasMixingConflict(p, lastId)) {
        const lastName = (PESTICIDE_DB.find(x => x.id === lastId) || {}).name;
        reasons.push(`${p.name}は前回散布薬剤（${lastName}）と混用不可`);
      }
    }
  }
  return reasons;
}

// セット単位の複合スコアリング（効果・安全性・抵抗性リスクの3軸を合成）
// 混合可否はゲートで既に保証済みのため非スコア軸として扱う
// pool: 同じ候補プール内の全薬剤（1剤で今回のunion coverageと同等以上をカバーできる薬剤が
//       他に存在するかどうかの判定に使う。存在する場合、2剤目は「冗長」と見なし、
//       異系統ボーナスを与えない＝効果が同一なら単剤側を優先させる）
function scorePrescriptionSet(pesticides, ebVector, safetyVector, pool) {
  const warnings = [];

  // ── 効果：union coverage（重複対象は加点せず、異なる対象のカバーだけが加点になる） ──
  const unionVector = ebVector.map((_, i) => pesticides.some(p => p.targetVector[i] > 0) ? 1 : 0);
  const matchCount = dotProduct(unionVector, ebVector);
  const targetSum = ebVector.reduce((s, v) => s + v, 0);
  const coverageRatio = targetSum > 0 ? matchCount / targetSum : 0;
  const effectivenessScore = matchCount * 10 + coverageRatio * 5;

  // ── 安全性：散布回数余裕・PHI・劇物区分 ──
  let safetyScore = 20;
  for (const p of pesticides) {
    if (safetyVector.intervalDays !== null && safetyVector.intervalDays < p.phiDays) {
      safetyScore -= 10;
      warnings.push(`${p.name}: PHI残日数要確認（前回散布から${safetyVector.intervalDays}日、PHI${p.phiDays}日）`);
    }
    if (p.toxicityClass === '劇物') {
      safetyScore -= 8;
      warnings.push(`${p.name}: 劇物区分`);
    }
  }
  safetyScore = Math.max(0, safetyScore);

  // ── 抵抗性リスク：系統ローテーションの偏り ──
  let resistanceScore = 15;
  let resistanceNote = '';
  for (const p of pesticides) {
    const rotationCount = safetyVector.rotationState[p.systemCode] || 0;
    if (rotationCount >= 2 && !NON_ROTATION_SYSTEM_CODES.includes(p.systemCode)) {
      resistanceScore -= 15;
      warnings.push(`${p.name}: 同系統（${p.system}）を${rotationCount}回連続使用中（抵抗性リスク）`);
    }
  }
  if (pesticides.length === 2) {
    const [a, b] = pesticides;
    const aRotates = !NON_ROTATION_SYSTEM_CODES.includes(a.systemCode);
    const bRotates = !NON_ROTATION_SYSTEM_CODES.includes(b.systemCode);
    // 2剤セットが、プール内のいずれかの単剤よりeffectivenessで純増しているか
    // （＝単剤で同等以上のunion coverageを達成できる薬剤が他に存在する場合は「冗長」と見なし、
    //   異系統ボーナスを与えない＝効果が同一なら単剤を優先させる）
    const soloAlternativeCoversAll = (pool || []).some(p =>
      dotProduct(p.targetVector, ebVector) >= matchCount
    );
    if (aRotates && bRotates) {
      if (a.systemCode === b.systemCode) {
        resistanceScore -= 20;
        resistanceNote = '同一系統の組み合わせ：抵抗性リスク低減効果なし';
        warnings.push(resistanceNote);
      } else if (!soloAlternativeCoversAll) {
        resistanceScore += 10;
        resistanceNote = `異なる系統（${a.systemCode}／${b.systemCode}）の組み合わせ：抵抗性管理上有効`;
      }
    }
  }
  resistanceScore = Math.max(0, resistanceScore);

  const totalScore = effectivenessScore + safetyScore + resistanceScore;

  return {
    pesticides,
    isCombo: pesticides.length > 1,
    matchCount,
    coverageRatio,
    effectivenessScore,
    safetyScore,
    resistanceScore,
    totalScore,
    warnings,
    breakdown: {
      effectiveness: { raw: effectivenessScore, coverageRatio, matchCount, targetSum },
      safety: { raw: safetyScore, warnings: warnings.filter(w => w.includes('PHI') || w.includes('劇物')) },
      resistance: { raw: resistanceScore, note: resistanceNote },
      mixing: { ok: true },
    },
  };
}

// EB診断結果とSafetyVectorから、1剤/2剤の全候補セットを列挙し、
// ゲート（混合可否・前回薬剤禁忌）を通過したものをスコアリングして
// 総合スコア最大の1セットを自動決定する
function buildPrescriptionSet(ebVector, safetyVector) {
  const matched = matchCandidates(ebVector);

  // ── Step1: 個体ハード除外（散布回数上限超過） ──
  const pool = [];
  const excludedIndividual = [];
  for (const m of matched) {
    const p = m.pesticide;
    const usageCount = safetyVector.usageState[p.id] || 0;
    if (usageCount >= p.maxApplications) {
      excludedIndividual.push({
        pesticides: [p],
        exclusionReasons: [`散布回数上限に到達（${usageCount}/${p.maxApplications === Infinity ? '無制限' : p.maxApplications}回）`],
      });
      continue;
    }
    pool.push(p);
  }

  if (pool.length === 0) {
    return { best: null, alternatives: [], excludedSets: [], excludedIndividual };
  }

  // ── Step2: 候補セット列挙（1剤・2剤） ──
  const candidateSets = pool.map(p => [p]);
  for (let i = 0; i < pool.length; i++) {
    for (let j = i + 1; j < pool.length; j++) {
      candidateSets.push([pool[i], pool[j]]);
    }
  }

  // ── Step3: セット単位ゲート（混合可否・前回薬剤との禁忌） ──
  const validSets = [];
  const excludedSets = [];
  for (const set of candidateSets) {
    const reasons = [];

    if (set.length === 2 && setHasInternalMixingConflict(set)) {
      reasons.push(...buildMixingReason(set[0], set[1]));
    }
    reasons.push(...findLastSprayConflictReasons(set, safetyVector));

    if (reasons.length > 0) {
      excludedSets.push({ pesticides: set, exclusionReasons: reasons });
    } else {
      validSets.push(set);
    }
  }

  // ── Step4: スコアリング ──
  const scored = validSets.map(set => scorePrescriptionSet(set, ebVector, safetyVector, pool));

  // ── Step5: 総合スコア最大のセットを選定（タイブレーク付き） ──
  scored.sort((a, b) => {
    if (b.totalScore !== a.totalScore) return b.totalScore - a.totalScore;
    if (b.effectivenessScore !== a.effectivenessScore) return b.effectivenessScore - a.effectivenessScore;
    if (a.pesticides.length !== b.pesticides.length) return a.pesticides.length - b.pesticides.length;
    const aKey = a.pesticides.map(p => p.id).sort().join(',');
    const bKey = b.pesticides.map(p => p.id).sort().join(',');
    return aKey.localeCompare(bKey);
  });

  const best = scored.length > 0 ? scored[0] : null;
  const alternatives = scored.slice(1);

  return { best, alternatives, excludedSets, excludedIndividual };
}

