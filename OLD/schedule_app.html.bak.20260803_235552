function renderCalendar() {
  document.getElementById('yearDisplay').textContent = currentYear + '年';
  const grid = document.getElementById('monthGrid');

  const months = ['1月','2月','3月','4月','5月','6月','7月','8月','9月','10月','11月','12月'];
  const weekDays = ['日','月','火','水','木','金','土'];
  const today = todayStr();

  let html = '';
  for (let m = 0; m < 12; m++) {
    const daysInMonth = new Date(currentYear, m + 1, 0).getDate();

    html += `<div class="month-card">`;
    html += `<div class="month-title">${months[m]}</div>`;
    html += `<table class="cal-table"><thead><tr>`;
    weekDays.forEach(d => { html += `<th>${d}</th>`; });
    html += `</tr></thead><tbody>`;

    // First day of month (0=Sun)
    let firstDow = new Date(currentYear, m, 1).getDay();
    let date = 1;

    for (let week = 0; week < 6; week++) {
      if (date > daysInMonth && firstDow > 0) break;
      html += `<tr>`;
      for (let dow = 0; dow < 7; dow++) {
        if (week === 0 && dow < firstDow) {
          html += `<td style="background:#f9f9f9"></td>`;
        } else if (date > daysInMonth) {
          html += `<td style="background:#f9f9f9"></td>`;
        } else {
          const dayStr = String(date).padStart(2, '0');
          const mmStr = String(m + 1).padStart(2, '0');
          const dateKey = `${currentYear}-${mmStr}-${dayStr}`;
          const isSun = dow === 0;
          const isSat = dow === 6;
          const isToday = dateKey === today;
          const isSelected = dateKey === selectedDate;
          const hasRec = !!records[dateKey];

          let cls = '';
          if (isSun) cls += ' sun';
          if (isSat) cls += ' sat';
          if (isToday) cls += ' today';
          if (isSelected) cls += ' selected';

          let inner = `<span class="day-label${cls}">${dayStr}</span>`;
          if (hasRec) inner += `<span class="day-badge has-record">✓</span>`;

          html += `<td class="${cls}" onclick="selectDate('${dateKey}')" title="${hasRec ? '実績あり: ' + records[dateKey].pests.join(', ') : ''}">${inner}</td>`;
          date++;
        }
      }
      html += `</tr>`;
    }

    html += `</tbody></table></div>`;
  }

  grid.innerHTML = html;
}

function todayStr() {
  const d = new Date();
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}

