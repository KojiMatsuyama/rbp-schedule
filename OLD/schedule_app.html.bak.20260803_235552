function importData() {
  const text = document.getElementById('importText').value.trim();
  if (!text) { alert('データを入力してください'); return; }

  const lines = text.split('\n').filter(l => l.trim());
  let imported = 0;

  lines.forEach(line => {
    const parts = line.split(/[,，]/).map(s => s.trim());
    if (parts.length < 2) return;

    const dateStr = parts[0];
    // Normalize date: if format is MM/DD, prepend year
    let normalizedDate = dateStr;
    if (/^\d{1,2}\/\d{1,2}$/.test(dateStr)) {
      normalizedDate = `${currentYear}-${dateStr.replace('/', '-')}`;
    }

    const pests = parts.slice(1).filter(p => p);
    const vector = new Array(10).fill(0);
    pests.forEach(name => {
      const found = DISEASES.find(d => d.name === name);
      if (found) vector[found.id] = 1;
    });

    if (vector.some(v => v > 0)) {
      records[normalizedDate] = { pests, vector };
      imported++;
    }
  });

  saveRecords();
  renderCalendar();
  alert(`${imported}件インポートしました`);
  document.getElementById('importText').value = '';
}

