# STB 農業AIアシスタント — APIキー設定
# このファイルを .env にコピーして API_KEY を記入してください
#
# Gemini APIキーの取得: https://aistudio.google.com/apikey

GEMINI_API_KEY=your-api-key-here

# ── Google Chat 通知設定 ──
# Google ChatのIncoming Webhook URL
# 設定手順:
#   1. Google Chat で通知を受けたいスペースを開く
#   2. 右上のギアアイコン → アプリの追加 → 「Incoming Webhooks」を検索・追加
#   3. Webhook URL をコピーして貼り付ける
#   4. ボットの名前を設定して保存
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/SPACE_ID/messages?key=KEY&token=TOKEN

# ── Slack 通知設定 ──
# 防除暦の処方自動生成結果を Slack に送る Webhook URL（Incoming Webhooks）
# 未設定の場合は DB 保存のみ行われ、通知は送られない
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── 防除暦 処方自動生成 ──
# 日程の何日前から処方を先回し生成するか（日数）
RX_LEAD_DAYS=3
